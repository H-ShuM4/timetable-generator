.venv/
__pycache__/
*.pyc
backend/.env
backend/data/sessions/
backend/logs/
.pytest_cache/

# 配布用 zip（timetable-generator.zip）は**追跡する**。事務局へ渡すものを
# ブランチから直接取れるようにするため。make-dist.sh は同じ内容から必ず
# 同じ zip を作るので、アプリを変えないかぎり差分は出ない。

# ブラウザ操作の副産物。スナップショットやコンソールログが溜まる。
.playwright-mcp/
test-results/

# 事務局から受け取った実データ。教員の実名を含むため追跡しない。
# 開発時はこのフォルダーに置いて使う。
/カリキュラム一覧*.xlsx
/教員一覧*.xlsx
# Excel 出力の様式の見本（事務局が作った実物）。これも実名を含む。
/*時間割*.xlsx

# 開発環境のローカル設定
.claude/
